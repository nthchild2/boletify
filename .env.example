# Database (Neon) — matches the BOLETIFY_ prefix from Neon's Vercel integration
# Get your connection string from Neon dashboard: https://neon.tech
BOLETIFY_DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
# Stripe (test mode while developing: keys start with sk_test_ / pk_test_)
# Dashboard → Developers → API keys. The web app reads these from apps/web/.env.local.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for /api/webhooks/stripe.
# Local: run `stripe listen --forward-to localhost:3001/api/webhooks/stripe` and copy the whsec_ value.
# Production: create the endpoint in the Stripe dashboard (events: payment_intent.succeeded,
# payment_intent.payment_failed, payment_intent.canceled) and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Secret used to sign ticket QR codes (HMAC). Generate with: openssl rand -base64 32
# Must stay the same once tickets are issued, or existing QR codes stop validating.
TICKET_QR_SECRET=

# Public URL of the web app, used for links and QR images in emails.
# Optional on Vercel (falls back to the production domain); set it locally if your port isn't 3000.
APP_URL=http://localhost:3001

# Email (Resend). Without RESEND_API_KEY emails are not sent: they're logged, and in
# development the HTML is written to $TMPDIR/boletify-emails (also: /api/dev/email-preview?order=BOL-…).
RESEND_API_KEY=re_...
# Sender on a domain verified in Resend. The default onboarding@resend.dev only delivers
# to the Resend account owner's own address.
EMAIL_FROM=Boletify <boletos@tu-dominio.com>
EMAIL_REPLY_TO=ayuda@boletify.com
